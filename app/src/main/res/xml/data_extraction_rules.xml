<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the same exclusions as backup_rules.xml, for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="adb/" />
        <exclude domain="file" path="snapshots/" />
        <exclude domain="file" path="last_crash.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="adb/" />
        <exclude domain="file" path="snapshots/" />
        <exclude domain="file" path="last_crash.txt" />
    </device-transfer>
</data-extraction-rules>
